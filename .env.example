# ═══════════════════════════════════════════════════
# GST Copilot — Environment Variables
# ═══════════════════════════════════════════════════
# Copy this file and fill in your values.
# NEVER commit this file to git.

# ───────────────────────────────────────────────────
# REQUIRED — App will NOT start without these
# ───────────────────────────────────────────────────

# PostgreSQL connection string
# Local:  postgresql://postgres:yourpassword@localhost:5432/gst_copilot
# Neon:   postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/gst_copilot

# JWT signing secret — MUST be 64+ random characters
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REPLACE_ME_WITH_64_CHAR_HEX

# ───────────────────────────────────────────────────
# OPTIONAL — Features degrade gracefully without these
# ───────────────────────────────────────────────────

# OpenAI API key — only needed for AI Assistant
# Get one at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxx

# Razorpay — only needed for billing/payments
# Get keys at: https://dashboard.razorpay.com/
# RAZORPAY_KEY_ID=rzp_test_xxx

# Log level (default: info)
# LOG_LEVEL=debug
